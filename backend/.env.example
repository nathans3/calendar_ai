# ─── Database ─────────────────────────────────────────────
# Get from Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Auth ─────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars

# ─── Server ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ─── OpenAI (Phase 3 — not needed yet) ───────────────────
OPENAI_API_KEY=sk-...
